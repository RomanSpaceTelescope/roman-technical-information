# ---
# datatype:
# - {name: filter, datatype: string, description: WFI filter name}
# - {name: RCSLEDBand, datatype: int64, description: RCS LEDP band}
# - {name: RCSLEDSide, datatype: string, description: RCS side (A or B)}
# - {name: RCSLEDBank, datatype: int64, description: RCS LED bank (1 or 2)}
# - {name: RCSLEDLowRangeC3, datatype: float64, description: Low current range flux-to-command-code polynomial coefficient for flux^3}
# - {name: RCSLEDLowRangeC2, datatype: float64, description: Low current range flux-to-command-code polynomial coefficient for flux^2}
# - {name: RCSLEDLowRangeC1, datatype: float64, description: Low current range flux-to-command-code polynomial coefficient for flux^1}
# - {name: RCSLEDLowRangeC0, datatype: float64, description: Low current range flux-to-command-code polynomial coefficient for flux^0}
# - {name: RCSLEDHighRangeC3, datatype: float64, description: High current range flux-to-command-code polynomial coefficient for flux^3}
# - {name: RCSLEDHighRangeC2, datatype: float64, description: High current range flux-to-command-code polynomial coefficient for flux^2}
# - {name: RCSLEDHighRangeC1, datatype: float64, description: High current range flux-to-command-code polynomial coefficient for flux^1}
# - {name: RCSLEDHighRangeC0, datatype: float64, description: High current range flux-to-command-code polynomial coefficient for flux^0}
# - {name: RCSLEDLowRangeMinFlux, unit: electron / (pix s), datatype: float64, description: Minimum flux for which the low range coefficients
#     are valid}
# - {name: RCSLEDLowRangeMaxFlux, unit: electron / (pix s), datatype: float64, description: Maximum flux for which the low range coefficients
#     are valid}
# - {name: RCSLEDHighRangeMinFlux, unit: electron / (pix s), datatype: float64, description: Minimum flux for which the high range coefficients
#     are valid}
# - {name: RCSLEDHighRangeMaxFlux, unit: electron / (pix s), datatype: float64, description: Maximum flux for which the high range coefficients
#     are valid}
# delimiter: ','
# meta: !!omap
# - comments: ['Roman WFI Relative Calibration System (RCS) LEDP flux-to-command-code 3rd order polynomial coefficients: code = C3*flux^3
#       + C2*flux^2 + C1*flux + C0. Low range applies for flux between RCSLEDLowRangeMinFlux and RCSLEDLowRangeMaxFlux (command code <=
#       65535); high range applies for flux between RCSLEDHighRangeMinFlux and RCSLEDHighRangeMaxFlux (command code > 65535, bit 16 set).']
