# - {name: RCSLEDSide, datatype: string, description: RCS side (A or B)}
# - {name: RCSLEDBank, datatype: int64, description: RCS LED bank (1 or 2)}
# - {name: RCSLEDLowRangeMinFlux, unit: electron / (pix s), datatype: float64, description: Minimum commandable flux in the low current
#     range}
# - {name: RCSLEDLowRangeMaxFlux, unit: electron / (pix s), datatype: float64, description: Maximum commandable flux in the low current
#     range}
# - {name: RCSLEDHighRangeMinFlux, unit: electron / (pix s), datatype: float64, description: Minimum commandable flux in the high current
#     range}
# - {name: RCSLEDHighRangeMaxFlux, unit: electron / (pix s), datatype: float64, description: Maximum commandable flux in the high current
#     range}
# - {name: RCSLEDFluxGap, unit: electron / (pix s), datatype: float64, description: 'RCSLEDHighRangeMinFlux minus RCSLEDLowRangeMaxFlux;
#     positive indicates a real gap between the low and high current ranges, negative indicates the ranges overlap'}
# - {name: RCSLEDHasFluxGap, datatype: bool, description: True if RCSLEDFluxGap is positive (a real flux gap exists)}
# - {name: RCSLEDDarkElementPeakToValley, unit: '%', datatype: float64, description: Dark element peak-to-valley non-uniformity; measured
#     on Side B Bank 1 only}
# - {name: RCSLEDLOLOPeakToValley, unit: '%', datatype: float64, description: LOLO (low flux) peak-to-valley non-uniformity; measured
#     on Side B Bank 2 only}
# - {name: RCSLEDLOLOPixelsPassingUniformity, unit: '%', datatype: float64, description: Percentage of LOLO pixels passing the 25% uniformity
#     requirement; measured on Side B Bank 2 only}
# delimiter: ','
# meta: !!omap
# - comments: ['Roman WFI Relative Calibration System (RCS) LEDP low/high current range flux bounds and the resulting flux gap; flux range
